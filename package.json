{
  "name": "yaviya-market",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env scripts/dev.mjs --dist",
    "start": "node --env-file-if-exists=.env scripts/dev.mjs --dist",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run check && node --test tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:owner": "node --env-file-if-exists=.env scripts/create-owner.mjs"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
