# Local development defaults to a local SQLite database. Never commit .env.
SQLITE_PATH=.local/yaviya.sqlite

# Required on Vercel. Populate only in project environment settings / local .env.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# For one-time administrator creation from a trusted local terminal only.
# Remove these two values from .env after npm run db:owner.
OWNER_LOGIN=
OWNER_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://votre-domaine/api/auth/google-callback

# Required to activate 2FA, server only. Generate once, never commit or rotate blindly:
# node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("hex")+"\n")'
# Store the same 64-character hex key in local .env and the intended Vercel environment.
MFA_ENCRYPTION_KEY=
